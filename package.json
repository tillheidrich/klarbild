{
  "name": "klarbild",
  "version": "1.0.0",
  "description": "Self-hosted print studio: put pictures on paper at exactly the size you asked for. Sheet layout with crop marks, tiling, 1:1 PDF. Optional AI, delivery, sharing and Telegram modules.",
  "license": "AGPL-3.0-only",
  "author": "Till Heidrich",
  "homepage": "https://github.com/tillheidrich/klarbild",
  "repository": {
    "type": "git",
    "url": "https://github.com/tillheidrich/klarbild.git"
  },
  "bugs": {
    "url": "https://github.com/tillheidrich/klarbild/issues"
  },
  "keywords": [
    "print",
    "pdf",
    "photo",
    "passport-photo",
    "self-hosted",
    "astro",
    "crop-marks",
    "poster",
    "tiling",
    "sheet-layout"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "start": "node ./dist/server/entry.mjs",
    "astro": "astro",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "scan": "node scripts/secret-scan.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^9.1.3",
    "@astrojs/react": "^4.2.1",
    "@aws-sdk/client-s3": "^3.700.0",
    "@fontsource/space-grotesk": "^5.1.0",
    "@fontsource/space-mono": "^5.1.0",
    "archiver": "^7.0.1",
    "argon2": "^0.41.1",
    "astro": "^5.5.0",
    "basic-ftp": "^5.0.5",
    "grammy": "^1.30.0",
    "heic-convert": "^2.1.0",
    "nodemailer": "^9.1.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.13.1",
    "pg-boss": "^10.1.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.33.5",
    "ssh2-sftp-client": "^11.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ssh2-sftp-client": "^9.0.6",
    "typescript": "^5.7.2"
  }
}
