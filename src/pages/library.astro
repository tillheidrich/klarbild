---
import Base from '../layouts/Base.astro';
import { has } from '../lib/modules';
import LibraryApp from '../components/LibraryApp.tsx';
import { tFor, dictFor } from '../lib/i18n.server';
// A page of a module that is off does not exist for this instance.
if (!has('ai')) return Astro.redirect('/print', 302);
const locale = Astro.locals.locale ?? 'en';
const t = tFor(locale);
const dict = dictFor(locale);
---
<Base title={t('Library · Klarbild')}>
  <h1 class="page-title">{t('Library')}</h1>
  <LibraryApp client:load locale={locale} dict={dict} />
  <style>.page-title{font-family:var(--font-display);font-size:1.6rem;margin:6px 0 16px;letter-spacing:-.02em;}</style>
</Base>
