---
import Base from '../../layouts/Base.astro';
import AdminApp from '../../components/AdminApp.tsx';
import { tFor, dictFor } from '../../lib/i18n.server';
if (Astro.locals.user?.role !== 'admin') return Astro.redirect('/');
const locale = Astro.locals.locale ?? 'en';
const t = tFor(locale);
const dict = dictFor(locale);
---
<Base title={t('Admin · Klarbild')}>
  <h1 class="page-title">{t('Admin')}</h1>
  <AdminApp client:load locale={locale} dict={dict} />
  <style>.page-title{font-family:var(--font-display);font-size:1.6rem;margin:6px 0 16px;letter-spacing:-.02em;}</style>
</Base>
