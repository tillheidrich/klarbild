---
// “Forgot your password” — reachable without signing in.
// Two states in one page: without a token ask for the address, with a token set
// the new password.
import Base from '../layouts/Base.astro';
import { tFor, dictFor } from '../lib/i18n.server';
const locale = Astro.locals.locale ?? 'en';
const t = tFor(locale);
const dict = dictFor(locale);
const token = Astro.url.searchParams.get('token') || '';
---
<Base title={t('Password · Klarbild')}>
  <main class="pw">
    <h1 class="display">Klarbild</h1>

    {token ? (
      <form id="setnew" class="card" data-token={token}
            data-mismatch={t('The two entries do not match.')}
            data-saved={t('Password saved. Taking you to the sign-in page …')}
            data-failed={t('That did not work.')}>
        <h2>{t('Set a new password')}</h2>
        <label>{t('New password')}
          <input name="password" type="password" autocomplete="new-password" required minlength="10"
                 placeholder={t('at least 10 characters')} autofocus />
        </label>
        <label>{t('Once more')}
          <input name="password2" type="password" autocomplete="new-password" required minlength="10" />
        </label>
        <button type="submit">{t('Save password')}</button>
        <p class="hint">{t('A long sentence is safer, and easier to remember, than a short piece of gibberish.')}</p>
        <p id="msg" class="msg" hidden></p>
      </form>
    ) : (
      <form id="request" class="card"
            data-sent={t('If there is an account for this address, the message is on its way. Have a look in the spam folder too.')}>
        <h2>{t('Forgot your password')}</h2>
        <p class="lead">{t('Enter your email address. If there is an account for it, a link will arrive shortly that lets you set a new password.')}</p>
        <label>{t('Email address')}
          <input name="email" type="email" autocomplete="email" required autofocus placeholder="you@example.com" />
        </label>
        <button type="submit">{t('Send the link')}</button>
        <p id="msg" class="msg" hidden></p>
      </form>
    )}

    <p class="back"><a href="/login">{t('← To the sign-in page')}</a></p>
  </main>

  <style>
    .pw { max-width: 400px; margin: 8vh auto 0; padding: 0 18px 60px; text-align: center; }
    .display { font-family: var(--font-display); font-size: 2.2rem; margin: 0 0 26px; letter-spacing: -0.02em; }
    .card { display: grid; gap: 14px; text-align: left; background: var(--surface);
      border: 1px solid var(--line); border-radius: var(--radius); padding: 22px; box-shadow: var(--shadow); }
    .card h2 { font-size: 1.1rem; margin: 0; }
    .lead { margin: 0; font-size: 0.9rem; color: var(--ink-soft); line-height: 1.6; }
    label { display: grid; gap: 6px; font-size: 0.9rem; color: var(--ink-soft); }
    input { padding: 11px 12px; border: 1px solid var(--line); border-radius: var(--radius-sm);
      background: var(--paper); color: var(--ink); font-size: 16px; font-family: inherit; }
    button { margin-top: 4px; padding: 12px; border: none; border-radius: var(--radius-sm);
      background: var(--accent); color: #fff; font-size: 1rem; font-weight: 600; cursor: pointer; font-family: inherit; }
    button:disabled { background: var(--paper); color: var(--soft); border: 1px solid var(--line); cursor: not-allowed; }
    .hint { margin: 0; font-size: 0.8rem; color: var(--soft); line-height: 1.5; }
    .msg { margin: 4px 0 0; font-size: 0.9rem; line-height: 1.5; }
    .msg.ok { color: var(--ok); }
    .msg.err { color: var(--err); }
    .back { margin-top: 22px; font-size: 0.9rem; }
  </style>

  <script>
    const show = (el: HTMLElement, text: string, ok: boolean) => {
      el.textContent = text; el.className = 'msg ' + (ok ? 'ok' : 'err'); (el as HTMLElement).hidden = false;
    };
    const post = (body: unknown) =>
      fetch('/api/auth/reset', { method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body) }).then((r) => r.json().catch(() => ({})));

    const request = document.getElementById('request') as HTMLFormElement | null;
    request?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const msg = document.getElementById('msg')!;
      const btn = request.querySelector('button')!;
      btn.disabled = true;
      const email = (new FormData(request).get('email') || '').toString();
      const r = await post({ email });
      btn.disabled = false;
      if (r.error) show(msg, r.error, false);
      else show(msg, request.dataset.sent!, true);
    });

    const setnew = document.getElementById('setnew') as HTMLFormElement | null;
    setnew?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const msg = document.getElementById('msg')!;
      const f = new FormData(setnew);
      const pw = (f.get('password') || '').toString();
      if (pw !== (f.get('password2') || '').toString()) { show(msg, setnew.dataset.mismatch!, false); return; }
      const btn = setnew.querySelector('button')!;
      btn.disabled = true;
      const r = await post({ token: setnew.dataset.token, password: pw });
      if (r.ok) { show(msg, setnew.dataset.saved!, true); setTimeout(() => (location.href = '/login'), 1400); }
      else { btn.disabled = false; show(msg, r.error || setnew.dataset.failed!, false); }
    });
  </script>
</Base>
