---
import Base from '../layouts/Base.astro';
import { has } from '../lib/modules';
import SharesApp from '../components/SharesApp';
import { tFor, dictFor } from '../lib/i18n.server';
// A page of a module that is off does not exist for this instance.
if (!has('share')) return Astro.redirect('/print', 302);
const locale = Astro.locals.locale ?? 'en';
const t = tFor(locale);
const dict = dictFor(locale);
---
<Base title={t('Shared links · Klarbild')}>
  <section class="page">
    <header class="pagehead">
      <h1>{t('Shared links')}</h1>
      <p class="lead">{t('Links that let other people look at your images — without an account. Here you can see how often they were opened, and switch them off whenever you want.')}</p>
    </header>
    <SharesApp client:load locale={locale} dict={dict} />
  </section>
  <style>
    .page { max-width: var(--maxw); margin: 0 auto; padding: 26px 20px 80px; }
    .pagehead { margin-bottom: 20px; }
    .pagehead h1 { font-size: clamp(1.4rem, 4vw, 1.9rem); margin: 0 0 6px; letter-spacing: -0.02em; }
    .lead { margin: 0; color: var(--ink-soft); line-height: 1.6; max-width: 64ch; font-size: 0.95rem; }
    @media (max-width: 640px) { .page { padding: 18px 14px 90px; } }
  </style>
</Base>
